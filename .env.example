# Copy to your host's environment settings (Vercel: Project Settings > Environment Variables).
# Locally, `npm run dev` reads the same names from the macOS Keychain (service "perp-race"),
# see scripts/secrets.mjs. Every exchange is optional: without its key an exchange reports
# network time only, and the race server leaves it out of the race.
# Use API keys with trade permission only (no withdrawals, no transfers) and keep a few dollars on each account.

# Somnia Tokyo mainnet wallet that places the DreamDEX order (a little SOMI for gas and about 10 USDso for margin)
DREAMDEX_KEY=

# Binance USD-M futures (HMAC key), trade permission with futures enabled
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit unified trading account (system-generated HMAC key), contract trade permission
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OKX (trade permission) and the passphrase set when the key was created
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Bitget classic account, USDT-M futures (trade permission) and the passphrase set when the key was created
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
